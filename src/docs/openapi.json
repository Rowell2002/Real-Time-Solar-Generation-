{
  "openapi": "3.0.3",
  "info": {
    "title": "SLSEA Solar Generation Monitoring API",
    "version": "1.1.0",
    "description": "Sri Lanka Sustainable Energy Authority (SLSEA) Real-Time Solar Generation Monitoring & Telemetry Processing REST API.\n\nProvides real-time IoT device telemetry ingestion, batch historical sync, administrative hierarchy navigation, operational analytics, district and national-level aggregation dashboards, conditional caching (ETag/304), rate-limiting protection, and fine-grained Role-Based Access Control (RBAC) with Write-Read security isolation.",
    "contact": {
      "name": "SLSEA Technical Architecture Team",
      "email": "api-support@slsea.gov.lk"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Environment Base URL"
    },
    {
      "url": "/api/v1",
      "description": "API Version 1 Endpoint"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "JWT Bearer token acquisition for analysts, administrators, and hardware IoT meters"
    },
    {
      "name": "System",
      "description": "System operational status, health probes, and database readiness"
    },
    {
      "name": "Hierarchy Navigation",
      "description": "Geographical and grid hierarchy scoping: Provinces, Districts, and Grid Substations"
    },
    {
      "name": "Installations",
      "description": "Solar installation management, composite views, and derived operational reads"
    },
    {
      "name": "Telemetry & Ingestion",
      "description": "Device telemetry ingestion write path (single & high-throughput batch) and analytical historical query engine"
    },
    {
      "name": "District Analytics",
      "description": "High-performance operational summaries and aggregation dashboards at district level"
    },
    {
      "name": "National Analytics",
      "description": "Island-wide operational solar dashboard for CEB/SLSEA national command center"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer authentication token. Supply tokens containing device scopes ('installation:write:{id}') for telemetry ingestion, or user jurisdictional claims ('role': 'national'|'provincial'|'district', 'jurisdiction_id': UUID, 'scopes': ['read:national', 'read:province:{id}', 'read:district:{id}']) for analytical reads."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message", "detail", "timestamp"],
        "properties": {
          "code": {
            "type": "string",
            "example": "RESOURCE_NOT_FOUND",
            "description": "Machine-readable uppercase error identifier code"
          },
          "message": {
            "type": "string",
            "example": "The requested resource could not be found.",
            "description": "Human-readable summary message"
          },
          "detail": {
            "type": "string",
            "nullable": true,
            "example": "SolarInstallation with id '8e27c1b4-6a75-45d3-8be2-7f9999999999' was not found in the database.",
            "description": "Specific technical detail, validation error, or parameter violation"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-02T04:15:30.000Z",
            "description": "ISO 8601 UTC timestamp of error generation"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "timestamp", "service"],
        "properties": {
          "status": { "type": "string", "example": "healthy" },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-10-02T04:15:30.000Z" },
          "service": { "type": "string", "example": "SLSEA Solar Generation Tracking API" }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "required": ["status", "database", "dialect", "latency_ms", "timestamp", "service"],
        "properties": {
          "status": { "type": "string", "example": "ready" },
          "database": { "type": "string", "example": "connected" },
          "dialect": { "type": "string", "example": "postgres" },
          "latency_ms": { "type": "number", "example": 2.5 },
          "timestamp": { "type": "string", "format": "date-time" },
          "service": { "type": "string", "example": "SLSEA Solar Generation Tracking API" }
        }
      },
      "LoginPayload": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "national.admin@slsea.gov.lk" },
          "password": { "type": "string", "example": "Password123!" }
        }
      },
      "LoginSuccessResponse": {
        "type": "object",
        "required": ["message", "token", "token_type", "expires_in", "user"],
        "properties": {
          "message": { "type": "string", "example": "Authentication successful." },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsIn..." },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "string", "example": "24h" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "email": { "type": "string" },
              "role": { "type": "string", "enum": ["national", "provincial", "district"] },
              "jurisdiction_id": { "type": "string", "nullable": true, "format": "uuid" },
              "scopes": { "type": "array", "items": { "type": "string" }, "example": ["read:national"] }
            }
          }
        }
      },
      "DeviceTokenPayload": {
        "type": "object",
        "properties": {
          "installation_id": { "type": "string", "format": "uuid", "example": "018f4a12-7b32-7c80-87a1-f0a801234567" },
          "meter_id": { "type": "string", "example": "MTR-WP-COL-001" }
        }
      },
      "DeviceTokenSuccessResponse": {
        "type": "object",
        "required": ["message", "token", "token_type", "expires_in", "device"],
        "properties": {
          "message": { "type": "string", "example": "Device write token issued successfully." },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsIn..." },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "string", "example": "24h" },
          "device": {
            "type": "object",
            "properties": {
              "installation_id": { "type": "string", "format": "uuid" },
              "meter_id": { "type": "string" },
              "scope": { "type": "string", "example": "installation:write:018f4a12-7b32-7c80-87a1-f0a801234567" },
              "scopes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "Province": {
        "type": "object",
        "required": ["id", "name", "code"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "018f4a12-7b32-7c80-87a1-c0a801234567" },
          "name": { "type": "string", "example": "Western" },
          "code": { "type": "string", "example": "WP" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "District": {
        "type": "object",
        "required": ["id", "name", "province_id"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "018f4a12-7b32-7c80-87a1-d0a801234567" },
          "name": { "type": "string", "example": "Colombo" },
          "province_id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "GridSubstation": {
        "type": "object",
        "required": ["id", "name", "capacity_mw", "district_id"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "018f4a12-7b32-7c80-87a1-e0a801234567" },
          "name": { "type": "string", "example": "Kolonnawa Grid Substation" },
          "capacity_mw": { "type": "number", "format": "float", "example": 60.0 },
          "district_id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "SolarInstallation": {
        "type": "object",
        "required": ["id", "name", "capacity_kw", "installation_type", "meter_id", "grid_substation_id"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "018f4a12-7b32-7c80-87a1-f0a801234567" },
          "name": { "type": "string", "example": "Colombo Port Commercial Solar Array 1" },
          "capacity_kw": { "type": "number", "format": "float", "example": 250.0 },
          "installation_type": { "type": "string", "enum": ["rooftop", "ground_mounted", "floating", "agrivoltaic"], "example": "rooftop" },
          "meter_id": { "type": "string", "example": "MTR-WP-COL-001" },
          "grid_substation_id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CompositeInstallation": {
        "type": "object",
        "properties": {
          "installation": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "capacity_kw": { "type": "number" },
              "installation_type": { "type": "string" },
              "meter_id": { "type": "string" },
              "grid_substation": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "name": { "type": "string" },
                  "capacity_mw": { "type": "number" },
                  "district": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "format": "uuid" },
                      "name": { "type": "string" },
                      "province": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "format": "uuid" },
                          "name": { "type": "string" },
                          "code": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              },
              "summary_stats": {
                "type": "object",
                "properties": {
                  "total_readings": { "type": "integer", "example": 672 },
                  "latest_cumulative_energy_kwh": { "type": "number", "example": 8945.2 },
                  "current_power_kw": { "type": "number", "example": 195.4 },
                  "max_power_kw_recorded": { "type": "number", "example": 242.8 },
                  "avg_voltage_v": { "type": "number", "example": 230.15 },
                  "first_reading_timestamp": { "type": "string", "format": "date-time" },
                  "last_reading_timestamp": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        }
      },
      "LastReading": {
        "type": "object",
        "required": ["installation_id", "meter_id", "last_reading"],
        "properties": {
          "installation_id": { "type": "string", "format": "uuid" },
          "meter_id": { "type": "string", "example": "MTR-WP-COL-001" },
          "last_reading": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "timestamp": { "type": "string", "format": "date-time" },
              "power_kw": { "type": "number", "example": 182.5 },
              "energy_kwh": { "type": "number", "example": 8945.2 },
              "voltage_v": { "type": "number", "example": 230.2 }
            }
          }
        }
      },
      "ReadingIngestPayload": {
        "type": "object",
        "required": ["timestamp", "power_kw", "energy_kwh", "voltage_v"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-10-02T04:15:00.000Z" },
          "power_kw": { "type": "number", "minimum": 0, "example": 145.25 },
          "energy_kwh": { "type": "number", "minimum": 0, "example": 1250.75 },
          "voltage_v": { "type": "number", "minimum": 0, "example": 230.5 }
        }
      },
      "BatchReadingsPayload": {
        "type": "object",
        "required": ["readings"],
        "properties": {
          "readings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReadingIngestPayload" },
            "description": "Array of telemetry readings (up to 500 records per batch)"
          }
        }
      },
      "BatchReadingsSuccessResponse": {
        "type": "object",
        "required": ["message", "data", "_links"],
        "properties": {
          "message": { "type": "string", "example": "Batch telemetry readings processed successfully." },
          "data": {
            "type": "object",
            "properties": {
              "installation_id": { "type": "string", "format": "uuid" },
              "meter_id": { "type": "string", "example": "MTR-WP-COL-001" },
              "total_received": { "type": "integer", "example": 96 },
              "inserted_count": { "type": "integer", "example": 96 },
              "duplicate_skipped_count": { "type": "integer", "example": 0 },
              "first_timestamp": { "type": "string", "format": "date-time" },
              "last_timestamp": { "type": "string", "format": "date-time" }
            }
          },
          "_links": {
            "type": "object",
            "properties": {
              "self": { "type": "object", "properties": { "href": { "type": "string" } } },
              "readings": { "type": "object", "properties": { "href": { "type": "string" } } },
              "last_reading": { "type": "object", "properties": { "href": { "type": "string" } } }
            }
          }
        }
      },
      "ReadingIngestSuccess": {
        "type": "object",
        "required": ["message", "data", "_links"],
        "properties": {
          "message": { "type": "string", "example": "Telemetry reading successfully recorded." },
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "installation_id": { "type": "string", "format": "uuid" },
              "timestamp": { "type": "string", "format": "date-time" },
              "power_kw": { "type": "number", "example": 145.25 },
              "energy_kwh": { "type": "number", "example": 1250.75 },
              "voltage_v": { "type": "number", "example": 230.5 }
            }
          },
          "_links": {
            "type": "object",
            "properties": {
              "self": { "type": "object", "properties": { "href": { "type": "string" } } },
              "installation": { "type": "object", "properties": { "href": { "type": "string" } } },
              "last_reading": { "type": "object", "properties": { "href": { "type": "string" } } }
            }
          }
        }
      },
      "PaginatedReadingsEnvelope": {
        "type": "object",
        "required": ["total_count", "page", "limit", "data", "links"],
        "properties": {
          "total_count": { "type": "integer", "example": 672 },
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 50 },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "installation_id": { "type": "string", "format": "uuid" },
                "timestamp": { "type": "string", "format": "date-time" },
                "power_kw": { "type": "number" },
                "energy_kwh": { "type": "number" },
                "voltage_v": { "type": "number" }
              }
            }
          },
          "links": {
            "type": "object",
            "required": ["self"],
            "properties": {
              "self": { "type": "string" },
              "next": { "type": "string", "nullable": true },
              "prev": { "type": "string", "nullable": true }
            }
          }
        }
      },
      "DistrictSummary": {
        "type": "object",
        "required": ["district_id", "district_name", "total_active_installations", "current_total_power_kw", "today_total_energy_kwh", "substation_breakdown"],
        "properties": {
          "district_id": { "type": "string", "format": "uuid" },
          "district_name": { "type": "string", "example": "Colombo" },
          "total_active_installations": { "type": "integer", "example": 24 },
          "current_total_power_kw": { "type": "number", "example": 4210.8 },
          "today_total_energy_kwh": { "type": "number", "example": 18450.75 },
          "substation_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "substation_id": { "type": "string", "format": "uuid" },
                "substation_name": { "type": "string", "example": "Kolonnawa Grid Substation" },
                "capacity_mw": { "type": "number", "example": 60.0 },
                "active_installations_count": { "type": "integer", "example": 8 },
                "current_total_power_kw": { "type": "number", "example": 1420.5 }
              }
            }
          }
        }
      },
      "NationalSummary": {
        "type": "object",
        "required": ["country", "total_provinces", "total_active_installations", "current_total_power_kw", "current_total_power_mw", "today_total_energy_kwh", "today_total_energy_mwh", "provinces_breakdown"],
        "properties": {
          "country": { "type": "string", "example": "Sri Lanka" },
          "total_provinces": { "type": "integer", "example": 9 },
          "total_active_installations": { "type": "integer", "example": 200 },
          "current_total_power_kw": { "type": "number", "example": 38450.25 },
          "current_total_power_mw": { "type": "number", "example": 38.45 },
          "today_total_energy_kwh": { "type": "number", "example": 164210.5 },
          "today_total_energy_mwh": { "type": "number", "example": 164.21 },
          "provinces_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "province_id": { "type": "string", "format": "uuid" },
                "province_name": { "type": "string", "example": "Western" },
                "province_code": { "type": "string", "example": "WP" },
                "active_installations_count": { "type": "integer", "example": 48 },
                "current_total_power_kw": { "type": "number", "example": 9840.5 },
                "current_total_power_mw": { "type": "number", "example": 9.84 },
                "today_total_energy_kwh": { "type": "number", "example": 42100.25 }
              }
            }
          },
          "computed_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User Login & JWT Bearer Token Issuance",
        "description": "Authenticates analyst/official credentials and issues role-scoped JWT token ('national', 'provincial', 'district').",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginPayload" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. JWT token issued.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginSuccessResponse" } } }
          },
          "400": { "description": "Missing email or password.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Invalid credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/device-token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Issue Metering Device Ingestion Token",
        "description": "Generates a scoped device write token ('installation:write:{id}') for an IoT smart solar meter.",
        "operationId": "issueDeviceToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeviceTokenPayload" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device token generated.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceTokenSuccessResponse" } } }
          },
          "400": { "description": "Missing installation_id or meter_id.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Solar installation not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Inspect Current Token Principal Claims",
        "description": "Returns decoded token payload, roles, scopes, and expiration of the authenticated client.",
        "operationId": "getMe",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Decoded principal returned.",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "401": { "description": "Authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "API Service Liveness Probe",
        "description": "Returns current operational status, uptime timestamp, and service identifier.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy and process is running.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["System"],
        "summary": "Deep Database Readiness Probe",
        "description": "Verifies active database cluster connectivity, measures query roundtrip latency, and confirms dialect.",
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "description": "Database is connected and ready to accept traffic.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } } }
          },
          "503": {
            "description": "Database connection unavailable or timed out.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/provinces": {
      "get": {
        "tags": ["Hierarchy Navigation"],
        "summary": "List Administrative Provinces",
        "description": "Retrieves the collection of all 9 administrative provinces across Sri Lanka.",
        "operationId": "getProvinces",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Array of provinces returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer", "example": 9 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Province" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication token missing or invalid.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/provinces/{id}/districts": {
      "get": {
        "tags": ["Hierarchy Navigation"],
        "summary": "Get Districts in a Province",
        "description": "Scoped collection returning all districts belonging to a specific administrative province.",
        "operationId": "getProvinceDistricts",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Districts in province returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "province": { "$ref": "#/components/schemas/Province" },
                    "count": { "type": "integer" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/District" } }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid UUID parameter.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
