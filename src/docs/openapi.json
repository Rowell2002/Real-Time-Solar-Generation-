    "/installations/{id}/readings": {
      "post": {
        "tags": ["Telemetry & Ingestion"],
        "summary": "Device Ingestion: Append Telemetry Reading",
        "description": "Write path for smart metering devices. Enforces JWT token containing scope claim 'installation:write:{id}' cross-validated against the MySQL database. Returns 201 Created with Location header pointing to created reading URI.",
        "operationId": "createReading",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingIngestPayload" } } }
        },
        "responses": {
          "201": {
            "description": "Reading successfully recorded.",
            "headers": { "Location": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadingIngestSuccess" } } }
          },
          "400": { "description": "Bad Request.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Device authentication required.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden: Device not authorized for this installation.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Target solar installation not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "Conflict: Duplicate timestamp.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "422": { "description": "Validation error.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "get": {
        "tags": ["Telemetry & Ingestion"],
        "summary": "Analytical Historical Readings Query Engine",
        "description": "Retrieves paginated historical telemetry with multi-dimensional filtering, sorting, HATEOAS links, SHA-256 ETag caching, 304 conditional GET, 412 precondition verification, and 406 content negotiation.",
        "operationId": "getInstallationReadings",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 200 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["timestamp", "-timestamp"], "default": "-timestamp" } },
          { "name": "start_time", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "end_time", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "province_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "district_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "substation_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } },
          { "name": "If-Match", "in": "header", "schema": { "type": "string" } },
          { "name": "Accept", "in": "header", "schema": { "type": "string", "default": "application/json" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated telemetry envelope returned.",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "Last-Modified": { "schema": { "type": "string" } },
              "Cache-Control": { "schema": { "type": "string" } }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginatedReadingsEnvelope" } } }
          },
          "304": { "description": "Not Modified." },
          "400": { "description": "Bad Request.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Unauthorized.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Forbidden.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Installation not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "406": { "description": "Not Acceptable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "412": { "description": "Precondition Failed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
