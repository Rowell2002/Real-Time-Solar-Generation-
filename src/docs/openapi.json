      "get": {
        "tags": ["Telemetry & Ingestion"],
        "summary": "Analytical Historical Readings Query Engine",
        "description": "Retrieves paginated historical telemetry with multi-dimensional filtering (time window, province, district, substation), sorting, HATEOAS links, SHA-256 ETag caching, 304 conditional GET, 412 precondition verification, and 406 content negotiation.",
        "operationId": "getInstallationReadings",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Solar Installation UUID",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (defaults to 1)",
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Records per page (defaults to 50, maximum 200)",
            "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order by timestamp: 'timestamp' (ascending) or '-timestamp' (descending)",
            "schema": { "type": "string", "enum": ["timestamp", "-timestamp"], "default": "-timestamp" }
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "description": "Filter readings on or after this ISO 8601 timestamp",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "description": "Filter readings on or before this ISO 8601 timestamp",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "province_id",
            "in": "query",
            "required": false,
            "description": "Filter by administrative province UUID scope",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "district_id",
            "in": "query",
            "required": false,
            "description": "Filter by administrative district UUID scope",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "substation_id",
            "in": "query",
            "required": false,
            "description": "Filter by grid substation UUID scope",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "SHA-256 ETag for conditional GET validation",
            "schema": { "type": "string" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "description": "Precondition ETag matching header",
            "schema": { "type": "string" }
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "Requested media format (must accept 'application/json')",
            "schema": { "type": "string", "default": "application/json" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated telemetry envelope returned successfully.",
            "headers": {
              "ETag": { "schema": { "type": "string" }, "description": "SHA-256 entity tag of dataset" },
              "Last-Modified": { "schema": { "type": "string" }, "description": "HTTP date of newest record in page" },
              "Cache-Control": { "schema": { "type": "string" }, "example": "public, max-age=60, must-revalidate" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginatedReadingsEnvelope" } } }
          },
          "304": {
            "description": "Not Modified: ETag or If-Modified-Since evaluated to true. Cached client copy is fresh."
          },
          "400": {
            "description": "Bad Request: Malformed UUID, page/limit out of bounds, invalid sort parameter, or chronological mismatch.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Authentication credentials required.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Forbidden: User jurisdictional scope excludes this installation.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "Installation not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "406": {
            "description": "Not Acceptable: Client requested unsupported media type (Accept header does not match application/json).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "412": {
            "description": "Precondition Failed: If-Match or If-Unmodified-Since precondition evaluated to false.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
